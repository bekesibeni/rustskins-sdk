{
  "name": "rustskins-sdk",
  "version": "1.1.0",
  "description": "A TypeScript SDK for interacting with the RustSkins API",
  "author": "benji",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx test/rustskins.test.ts",
    "prepare": "tsdown",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "got": "^16.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
